{
  "name": "forge-cli",
  "version": "0.1.0",
  "description": "An open-source AI terminal agent inspired by Gemini CLI. Bring powerful AI coding assistance directly into your terminal.",
  "type": "module",
  "bin": {
    "forge": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepare": "npm run build"
  },
  "keywords": [
    "ai",
    "cli",
    "agent",
    "gemini",
    "coding-assistant",
    "terminal",
    "llm",
    "tools"
  ],
  "author": "varshithpediredla-ctrl",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "ora": "^8.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
